# Скопируйте в bot/.env. Вложенные поля — через двойное подчёркивание.

# LLM: любой OpenAI-совместимый сервер. По умолчанию — Yandex AI Studio.
#   Yandex AI Studio: base_url ниже, LLM__PROJECT = id каталога, LLM__MODEL = имя модели
#     (клиент соберёт URI gpt://<каталог>/<модель>). Ключ — API-ключ сервисного аккаунта
#     с ролью ai.languageModels.user. Ключ не коммитить: bot/.env в .gitignore.
#   Ollama:  LLM__BASE_URL=http://<IP>:11434/v1, LLM__PROJECT пустой, LLM__MODEL=qwen3:8b
#   vLLM:    LLM__BASE_URL=http://<IP>:8000/v1
LLM__BASE_URL=https://ai.api.cloud.yandex.net/v1
LLM__API_KEY=
LLM__PROJECT=
LLM__MODEL=qwen3.6-35b-a3b
LLM__TIMEOUT_S=12
LLM__TEMPERATURE=0.1
# Рассуждения Qwen3.x выключены: иначе они съедают MAX_TOKENS и ответ пустой. Пусто — не передавать.
LLM__REASONING_EFFORT=none
# json_schema | json_object | none — какой работает, покажет: python -m polybot.check_llm
LLM__RESPONSE_FORMAT=json_schema
# Yandex: заголовок x-data-logging-enabled: false (C08)
LLM__DISABLE_DATA_LOGGING=true
# Цена за 1000 токенов, ₽ — для стоимости прогонов (Qwen3.6 35B: 0,2 вход / 0,3 выход)
LLM__PRICE_IN_PER_1K=0.2
LLM__PRICE_OUT_PER_1K=0.3

# Поиск (этап 1). Локальный Qdrant в папке (по умолчанию) или сервер:
#   RETRIEVAL__QDRANT_PATH=            ← пусто, чтобы использовать сервер
#   RETRIEVAL__QDRANT_URL=http://localhost:6333
RETRIEVAL__QDRANT_PATH=data/qdrant_local
RETRIEVAL__COLLECTION=polygraphy_kb
RETRIEVAL__DENSE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RETRIEVAL__TOP_K=5
RETRIEVAL__PREFETCH_K=30
# hybrid | dense | bm25; вес BM25 в RRF; сколько чанков OmniDesk допускается в top_k
RETRIEVAL__MODE=hybrid
RETRIEVAL__BM25_WEIGHT=2
# вес BM25 по заголовкам разделов (0 — выключен)
RETRIEVAL__TITLE_WEIGHT=1
RETRIEVAL__OMNIDESK_K=2
# Пороги evidence_gate (косинус) — по отчёту python -m harness.retrieval_eval
RETRIEVAL__MIN_SCORE=0.5
RETRIEVAL__MIN_CHUNK_SCORE=0.3
RETRIEVAL__CHUNK_CHARS=900
RETRIEVAL__CHUNK_OVERLAP=150

# Лимиты контракта
LIMITS__MAX_INPUT_CHARS=2000
LIMITS__MAX_CLARIFICATIONS=5
LIMITS__MAX_STEPS=10

# Telegram: токен от @BotFather (только здесь, не в git). Пока бот в разработке —
# id пользователей через запятую (свой id бот пришлёт на /id); пусто — доступ всем.
TELEGRAM__TOKEN=
TELEGRAM__ALLOWED_USER_IDS=

# Состояние чатов и журнал ходов Telegram-бота (харнесс и тесты хранят в памяти)
STORAGE__BACKEND=sqlite
STORAGE__SQLITE_PATH=data/polybot.sqlite3
STORAGE__KEEP_HISTORY=50

# Передача консультанту (C06): таймаут инструмента, с; черновики — в той же SQLite (handoff_requests)
HANDOFF__TIMEOUT_S=3
