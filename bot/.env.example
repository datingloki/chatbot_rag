# Скопируйте в bot/.env. Вложенные поля — через двойное подчёркивание.

# LLM: любой OpenAI-совместимый сервер.
#   Ollama на этой машине:          http://localhost:11434/v1
#   Ollama на другом компьютере:    http://<IP-компьютера>:11434/v1  (там OLLAMA_HOST=0.0.0.0)
#   vLLM на GPU-сервере Рег.облака: http://<IP-сервера>:8000/v1
LLM__BASE_URL=http://localhost:11434/v1
LLM__MODEL=qwen3:4b
LLM__API_KEY=not-needed
LLM__TIMEOUT_S=20
LLM__TEMPERATURE=0.1
LLM__SEED=42

# Поиск (этап 1)
RETRIEVAL__QDRANT_URL=http://localhost:6333
RETRIEVAL__COLLECTION=polygraphy_kb
RETRIEVAL__TOP_K=5
RETRIEVAL__MIN_SCORE=0.5

# Лимиты контракта
LIMITS__MAX_INPUT_CHARS=2000
LIMITS__MAX_CLARIFICATIONS=5
LIMITS__MAX_STEPS=10
